es les règles métier, planificateur (chaque minute + minuit)&lt;br&gt;server/&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fontColor=#1c2420;verticalAlign=middle;spacing=8;fillColor=#e1ece8;strokeColor=#164d43;" vertex="1" parent="1"><mxGeometry x="350" y="410" width="260" height="130" as="geometry"/></mxCell><mxCell id="db" value="&lt;b style=&quot;font-size:14px&quot;&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Base de données]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;34 tables, migrations auto au démarrage&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fontColor=#1c2420;fillColor=#ece4f3;strokeColor=#6b4a8a;" vertex="1" parent="1"><mxGeometry x="390" y="610" width="180" height="110" as="geometry"/></mxCell><mxCell id="umami" value="&lt;b style=&quot;font-size:14px&quot;&gt;Umami&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[si configuré]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Statistiques du site public&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fontColor=#1c2420;verticalAlign=middle;spacing=8;fillColor=#f1f1f1;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="220" height="90" as="geometry"/></mxCell><mxCell id="monitoring" value="&lt;b style=&quot;font-size:14px&quot;&gt;Monitoring&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Prometheus · Grafana · Loki]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;docker-compose.monitoring.yml&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fontColor=#1c2420;verticalAlign=middle;spacing=8;fillColor=#ece4f3;strokeColor=#6b4a8a;" vertex="1" parent="1"><mxGeometry x="680" y="430" width="220" height="110" as="geometry"/></mxCell><mxCell id="mail" value="&lt;b style=&qu