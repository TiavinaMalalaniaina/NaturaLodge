<mxfile host="app.diagrams.net" agent="NaturaLodge docs generator" version="24.0.0"><diagram id="p1" name="1. Contexte"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b style=&quot;font-size:18px&quot;&gt;NaturaLodge — contexte&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5d6862&quot;&gt;Qui utilise le système et avec quels services extérieurs il échange.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1c2420;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="guest" value="&lt;b style=&quot;font-size:14px&quot;&gt;Client de l’hôtel&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Personne]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Découvre le lodge, demande une réservation, suit ses demandes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fontColor=#1c2420;verticalAlign=middle;spacing=8;fillColor=#164d43;strokeColor=#0f362f;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="120" y="80" width="220" height="90" as="geometry"/></mxCell><mxCell id="staff" value="&lt;b style=&quot;font-size:14px&quot;&gt;Personnel&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;[Personne]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Accueil, gérant, manager, admin&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fontColor=#1c2420;verticalAlign=middle;spacing=8;fillColor=#164d43;strokeColor=#0f362f;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="220" height="90" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b style=&quot;font-size:14px&quot;&g