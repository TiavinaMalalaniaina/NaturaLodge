# ─── Développement local ───────────────────────────────────────────────────────
# Copier en server/.env. Modèles déployés : .env.preprod.example / .env.production.example
# (à reporter dans les variables d'environnement Coolify, jamais committés remplis).
APP_ENV=development
LOG_LEVEL=debug
# 0 = journalise toutes les requêtes Prisma (pratique pour déboguer) ; 200 par défaut
SLOW_QUERY_THRESHOLD_MS=200

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/naturalodge?schema=public"
JWT_SECRET="change-this-to-a-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Proxys de confiance pour l'IP client (X-Forwarded-For) : nombre de sauts, liste de sous-réseaux, ou false
TRUST_PROXY="loopback, uniquelocal"

# Origine du site public pour CORS
WEBSITE_URL=http://localhost:4321

# Emails transactionnels (secrets uniquement côté serveur)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Natura Lodge <reservations@votre-domaine.com>"

# Notifications push du personnel (admin fermé). Générer une fois : npx web-push generate-vapid-keys
# Ne jamais changer les clés après mise en service : les appareils abonnés devraient se réabonner.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:contact@votre-domaine.com"
