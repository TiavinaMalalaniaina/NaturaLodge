# ─── PRÉPROD — modèle des variables à saisir dans Coolify (ressource server, branche `preprod`) ───
# Ne jamais committer ce fichier rempli. Toutes les valeurs doivent différer de la production.
APP_ENV=preprod
NODE_ENV=production
LOG_LEVEL=debug
SLOW_QUERY_THRESHOLD_MS=200
PORT=4000

# Base DÉDIÉE à la préprod (jamais la base de prod). Données : seed de démo ou copie anonymisée.
DATABASE_URL="postgresql://USER:PASSWORD@naturalodge-preprod-db:5432/naturalodge?schema=public"
DATABASE_SSL=false

# Secret propre à la préprod : un jeton émis en préprod ne doit pas être valide en prod.
JWT_SECRET="<openssl rand -hex 32>"
JWT_EXPIRES_IN="1d"

# https obligatoire hors développement (le démarrage échoue sinon)
FRONTEND_URL="https://admin-preprod.votre-domaine.com"
WEBSITE_URL="https://preprod.votre-domaine.com"

# Connexion client « Continuer avec Google » (facultatif : bouton masqué si vide).
# Client OAuth « Application Web » dans Google Cloud Console ; URI de redirection autorisée :
# https://preprod.votre-domaine.com/api/public/auth/google/callback (WEBSITE_URL + /api/public/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TRUST_PROXY="loopback, uniquelocal"

# Emails : TOUS redirigés vers cette adresse (sujet préfixé [PREPROD → destinataire]).
# Sans MAIL_REDIRECT_TO, aucun email n'est envoyé en préprod.
MAIL_REDIRECT_TO="equipe@votre-domaine.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Natura Lodge PREPROD <preprod@votre-domaine.com>"

# Paire VAPID propre à la préprod (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:contact@votre-domaine.com"
