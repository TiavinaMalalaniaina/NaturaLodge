# ─── PRODUCTION — modèle des variables à saisir dans Coolify (ressource server, branche `main`) ───
# Ne jamais committer ce fichier rempli.
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info
SLOW_QUERY_THRESHOLD_MS=200
PORT=4000

DATABASE_URL="postgresql://USER:PASSWORD@naturalodge-db:5432/naturalodge?schema=public"
DATABASE_SSL=false

JWT_SECRET="<openssl rand -hex 32>"
JWT_EXPIRES_IN="7d"

# https obligatoire hors développement (le démarrage échoue sinon)
FRONTEND_URL="https://admin.votre-domaine.com"
WEBSITE_URL="https://votre-domaine.com"
TRUST_PROXY="loopback, uniquelocal"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Natura Lodge <reservations@votre-domaine.com>"

# Ne jamais changer après mise en service (les appareils abonnés devraient se réabonner)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:contact@votre-domaine.com"

# Premier compte admin (npm run db:seed:init — le seed de démo est bloqué en production)
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=
