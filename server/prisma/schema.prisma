generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth / Staff ────────────────────────────────────────────────

model User {
  id                String        @id @default(cuid())
  username          String        @unique
  email             String?       @unique
  password          String
  name              String
  role              Role          @default(GERANT)
  status            UserStatus    @default(ACTIVE)
  avatar            String?
  joinedDate        DateTime      @default(now())
  lastLogin         DateTime?
  guestNotes        GuestNote[]
  createdBookings   Booking[]
  issuedInvoices    Invoice[]
  processedPayments Payment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bookingNotes      BookingNote[]
  journalEntries    JournalEntry[]
  approvedExpenses  Expense[]
  auditLogs         AuditLog[]
}

enum Role {
  ADMIN
  MANAGER
  GERANT
  HOUSEKEEPING
}

enum UserStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

// ─── Guests ──────────────────────────────────────────────────────

model Guest {
  id            String      @id @default(cuid())
  name          String
  email         String?     @unique
  phone         String?
  address       String?
  city          String?
  country       String?
  status        GuestStatus @default(STANDARD)
  memberSince   DateTime    @default(now())
  totalStays    Int         @default(0)
  lifetimeValue Int         @default(0)
  avatar        String?
  preferences   String[]
  notes         GuestNote[]
  bookings      Booking[]
  invoices      Invoice[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum GuestStatus {
  STANDARD
  VIP_MEMBER
  VIP_ELITE
  PLATINUM_TIER
}

model GuestNote {
  id        String   @id @default(cuid())
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

// ─── Rooms ───────────────────────────────────────────────────────

model RoomType {
  id          String        @id @default(cuid())
  name        String
  rate        Int
  description String        @default("")
  area        Int           @default(30)
  bedType     String        @default("King Size")
  capacity    Int           @default(2)
  view        String        @default("Garden View")
  features    RoomFeature[] @relation("RoomTypeToFeature")
  rooms       Room[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Room {
  id           String        @id @default(cuid())
  number       String        @unique
  status       RoomStatus    @default(AVAILABLE)
  images       String[]      @default([])
  rateOverride Int?
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  roomTypeId   String
  bookings     BookingRoom[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

model RoomFeature {
  id        String     @id @default(cuid())
  label     String
  iconName  String
  roomTypes RoomType[] @relation("RoomTypeToFeature")
}

// ─── Bookings ────────────────────────────────────────────────────

model Booking {
  id           String        @id @default(cuid())
  guest        Guest         @relation(fields: [guestId], references: [id])
  guestId      String
  createdBy    User?         @relation(fields: [createdById], references: [id])
  createdById  String?
  rooms        BookingRoom[]
  invoices     Invoice[]
  arrival      DateTime
  departure    DateTime
  status       BookingStatus @default(AWAITING)
  totalAmount  Int
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookingNotes BookingNote[]
}

model BookingRoom {
  id        String             @id @default(cuid())
  booking   Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  room      Room               @relation(fields: [roomId], references: [id])
  roomId    String
  arrival   DateTime
  departure DateTime
  roomRate  Int
  extras    BookingRoomExtra[]

  @@unique([bookingId, roomId])
  @@index([roomId, arrival, departure])
}

model BookingNote {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  AWAITING
  CANCELLED
  CHECKED_OUT        // legacy — plus jamais écrit par le code, conservé pour les lignes historiques
  CHECKED_OUT_UNPAID
  CHECKED_OUT_PAID
  CLOSED
}

// ─── Suppléments facturables (lit d'appoint, chauffage, etc.) ────

enum ExtraPricing {
  PER_NIGHT // multiplié par le nombre de nuits de la ligne BookingRoom
  ONE_TIME // facturé une seule fois, indépendant de la durée
}

model Extra {
  id        String             @id @default(cuid())
  name      String
  price     Int
  pricing   ExtraPricing       @default(ONE_TIME)
  // Suppression douce : un supplément déjà utilisé sur une réservation (même passée/clôturée) ne
  // doit jamais être réellement effacé, sinon l'historique des factures perdrait sa description.
  // Désactivé simplement retiré du choix pour de nouvelles lignes.
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  lines     BookingRoomExtra[]
}

model BookingRoomExtra {
  id            String       @id @default(cuid())
  bookingRoom   BookingRoom  @relation(fields: [bookingRoomId], references: [id], onDelete: Cascade)
  bookingRoomId String
  extra         Extra        @relation(fields: [extraId], references: [id])
  extraId       String
  quantity      Int          @default(1)
  // Snapshot du tarif/type au moment de l'ajout — même logique que BookingRoom.roomRate, qui
  // snapshot déjà roomType.rate : un changement de tarif catalogue ne doit pas modifier
  // rétroactivement une réservation déjà facturée.
  unitPrice     Int
  pricing       ExtraPricing

  @@unique([bookingRoomId, extraId])
}

// ─── Invoices ────────────────────────────────────────────────────

// STANDARD (facture normale) / DEPOSIT (acompte) / CREDIT_NOTE (avoir — une annulation à 100% du
// solde restant EST un avoir, pas un type séparé). Voir invoice.service.ts pour le cycle de vie
// brouillon → visé.
enum InvoiceKind {
  STANDARD
  DEPOSIT
  CREDIT_NOTE
}

model Invoice {
  id          String        @id @default(cuid())
  // Nullable : un brouillon (validatedAt = null) n'a pas encore de numéro — il n'en consomme un
  // qu'au visa, pour garantir une séquence sans trou dans l'ordre d'émission réel.
  number      String?       @unique
  kind        InvoiceKind   @default(STANDARD)
  booking     Booking       @relation(fields: [bookingId], references: [id])
  bookingId   String
  guest       Guest         @relation(fields: [guestId], references: [id])
  guestId     String
  issuedBy    User?         @relation(fields: [issuedById], references: [id])
  issuedById  String?
  status      InvoiceStatus @default(PENDING)
  // null = brouillon (librement modifiable, absent du grand livre) ; non-null = visé (figé, posté
  // au grand livre à cette date). `issuedAt` est (ré)écrit à la même valeur au moment du visa —
  // c'est la date d'émission légale, pas la date de création du brouillon.
  validatedAt DateTime?
  issuedAt    DateTime      @default(now())
  // Un CREDIT_NOTE pointe vers la facture qu'il crédite. Un DEPOSIT n'a pas besoin de FK vers la
  // facture finale qu'il alimente : il se retrouve par bookingId + kind (voir invoice.service.ts).
  relatesToInvoiceId String?
  relatesToInvoice   Invoice? @relation("InvoiceCredits", fields: [relatesToInvoiceId], references: [id])
  creditedBy         Invoice[] @relation("InvoiceCredits")
  dueAt       DateTime?
  paidAt      DateTime?
  totalAmount Int
  taxAmount   Int           @default(0)
  notes       String?
  items       InvoiceItem[]
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([bookingId, kind])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Int
  total       Int
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  CANCELLED
}

// ─── Payments ────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  invoiceId     String
  processedBy   User          @relation(fields: [processedById], references: [id])
  processedById String
  amount        Int
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  // Compte de trésorerie réel qui a reçu l'argent (caisse, Mvola, Orange Money N°x...) — distinct
  // de `method` qui reste le canal de paiement affiché au client (une même méthode Orange Money
  // peut atterrir sur l'un ou l'autre des 2 numéros).
  account       LedgerAccount @relation(fields: [accountId], references: [id])
  accountId     String
  reference     String?
  paidAt        DateTime      @default(now())
  notes         String?
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  MVOLA
  ORANGE_MONEY
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

// ─── Comptabilité (partie double) ───────────────────────────────

model LedgerAccount {
  id            String            @id @default(cuid())
  code          String            @unique
  name          String
  type          LedgerAccountType
  // Comptes qui représentent un lieu physique d'argent (caisse, banque, mobile money) — ce sont
  // eux qui alimentent le tableau de bord "où est l'argent", par opposition aux comptes de
  // charges/produits/tiers qui n'ont pas de solde en espèces.
  isCashAccount Boolean           @default(false)
  // Méthodes de paiement que ce compte peut recevoir (ex: Caisse -> [CASH]) — filtre le
  // sélecteur de compte du formulaire de paiement selon la méthode choisie. Vide pour les
  // méthodes sans compte dédié pour l'instant (CARD/BANK_TRANSFER/ONLINE, pas de banque encore).
  allowedMethods PaymentMethod[]  @default([])
  parent        LedgerAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  parentId      String?
  children      LedgerAccount[]   @relation("AccountHierarchy")
  isActive      Boolean           @default(true)
  lines         JournalLine[]
  payments      Payment[]
  expenses      Expense[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model JournalEntry {
  id               String        @id @default(cuid())
  number           String        @unique
  date             DateTime      @default(now())
  memo             String?
  source           JournalSource
  relatedPaymentId String?
  relatedInvoiceId String?
  relatedExpenseId String?
  postedBy         User?         @relation(fields: [postedById], references: [id])
  postedById       String?
  lines            JournalLine[]
  createdAt        DateTime      @default(now())
}

enum JournalSource {
  INVOICE
  INVOICE_CANCEL // legacy — plus jamais écrit (l'annulation d'une facture visée émet désormais un CREDIT_NOTE), conservé pour les écritures historiques
  CREDIT_NOTE
  PAYMENT
  PAYMENT_VOID
  EXPENSE
  TRANSFER
  CONTRIBUTION
  MANUAL
}

model JournalLine {
  id          String        @id @default(cuid())
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId     String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  accountId   String
  debit       Int           @default(0)
  credit      Int           @default(0)
  description String?

  @@index([accountId])
  @@index([entryId])
}

model Expense {
  id           String          @id @default(cuid())
  category     ExpenseCategory
  amount       Int
  description  String
  paidFrom     LedgerAccount   @relation(fields: [paidFromId], references: [id])
  paidFromId   String
  approvedBy   User?           @relation(fields: [approvedById], references: [id])
  approvedById String?
  incurredAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum ExpenseCategory {
  SUPPLIES
  UTILITIES
  MAINTENANCE
  MARKETING
  SALARIES
  OTHER
}

// ─── Audit ───────────────────────────────────────────────────────

// Capture générique de toute requête mutante (POST/PATCH/PUT/DELETE) authentifiée, posée par un
// middleware global plutôt qu'appelée à la main dans chaque service — sinon "toutes les actions"
// suppose de retoucher chaque route existante et d'y penser pour chaque future. En contrepartie,
// pas de texte métier lisible par écriture (ex: "Jean a confirmé la réservation X") : juste la
// requête brute (méthode, chemin, corps assaini, code retour), ce qui reste exploitable pour
// répondre à "qui a fait quoi, quand" sans devoir maintenir une liste de messages à jour.
model AuditLog {
  id           String   @id @default(cuid())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  method       String
  path         String
  resourceType String?
  resourceId   String?
  statusCode   Int
  body         Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ─── Permissions ─────────────────────────────────────────────────

// Catalogue des actions protégées de l'API — une entrée par permission logique (parfois
// plusieurs routes derrière une même clé quand elles ont toujours eu le même ensemble de rôles,
// ex: "bookings.manage_rooms" couvre 5 routes d'ajout/retrait de chambre et de supplément).
// `domain` regroupe pour un futur écran d'administration (Phase 3) — ex: "bookings", "invoices".
model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  domain      String
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

// Les 4 rôles restent l'enum Role existant (décision Phase 0 : pas de rôles personnalisés) — donc
// pas de table Role séparée, juste la liaison Role (enum) x Permission.
model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
}
