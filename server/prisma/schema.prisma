generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth / Staff ────────────────────────────────────────────────

model User {
  id                String        @id @default(cuid())
  username          String        @unique
  email             String?       @unique
  password          String
  name              String
  role              Role          @relation(fields: [roleId], references: [id])
  roleId            String
  status            UserStatus    @default(ACTIVE)
  avatar            String?
  joinedDate        DateTime      @default(now())
  lastLogin         DateTime?
  guestNotes        GuestNote[]
  createdBookings   Booking[]
  issuedInvoices    Invoice[]
  processedPayments Payment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bookingNotes      BookingNote[]
  journalEntries    JournalEntry[]
  approvedExpenses  Expense[]
  auditLogs         AuditLog[]

  @@index([roleId])
}

// Rôles configurables par l'ADMIN (écran Permissions) — les 4 rôles historiques (isSystem: true)
// ne peuvent pas être supprimés, mais peuvent être renommés comme n'importe quel autre rôle. Un
// rôle custom démarre sans aucune permission accordée ; l'ADMIN les coche ensuite case par case
// sur la même matrice que les rôles historiques.
model Role {
  id            String              @id @default(cuid())
  name          String              @unique
  isSystem      Boolean             @default(false)
  users         User[]
  rolePerms     RolePermission[]
  ledgerAccess  RoleLedgerAccount[]
  createdAt     DateTime            @default(now())
}

enum UserStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

// ─── Guests ──────────────────────────────────────────────────────

model Guest {
  id            String      @id @default(cuid())
  name          String
  email         String?     @unique
  phone         String?
  address       String?
  city          String?
  country       String?
  status        GuestStatus @default(STANDARD)
  memberSince   DateTime    @default(now())
  totalStays    Int         @default(0)
  lifetimeValue Int         @default(0)
  avatar        String?
  preferences   String[]
  notes         GuestNote[]
  bookings      Booking[]
  invoices      Invoice[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum GuestStatus {
  STANDARD
  VIP_MEMBER
  VIP_ELITE
  PLATINUM_TIER
}

model GuestNote {
  id        String   @id @default(cuid())
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

// ─── Rooms ───────────────────────────────────────────────────────

model RoomType {
  id          String        @id @default(cuid())
  name        String
  rate        Int
  description String        @default("")
  area        Int           @default(30)
  bedType     String        @default("King Size")
  capacity    Int           @default(2)
  view        String        @default("Garden View")
  features    RoomFeature[] @relation("RoomTypeToFeature")
  rooms       Room[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Room {
  id           String        @id @default(cuid())
  number       String        @unique
  status       RoomStatus    @default(AVAILABLE)
  images       String[]      @default([])
  rateOverride Int?
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  roomTypeId   String
  bookings     BookingRoom[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

model RoomFeature {
  id        String     @id @default(cuid())
  label     String
  iconName  String
  roomTypes RoomType[] @relation("RoomTypeToFeature")
}

// ─── Bookings ────────────────────────────────────────────────────

model Booking {
  id           String        @id @default(cuid())
  guest        Guest         @relation(fields: [guestId], references: [id])
  guestId      String
  createdBy    User?         @relation(fields: [createdById], references: [id])
  createdById  String?
  rooms        BookingRoom[]
  invoices     Invoice[]
  arrival      DateTime
  departure    DateTime
  status       BookingStatus @default(AWAITING)
  // Horodatage réel du geste (pas la date prévue arrival/departure) — écrit par updateStatus()
  // au check-in / check-out, effacé par un retour en arrière (revert). Imprimé sur la facture ;
  // tant que null, la facture retombe sur arrival/departure.
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  totalAmount  Int
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookingNotes BookingNote[]
}

model BookingRoom {
  id        String             @id @default(cuid())
  booking   Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  room      Room               @relation(fields: [roomId], references: [id])
  roomId    String
  arrival   DateTime
  departure DateTime
  roomRate  Int
  extras    BookingRoomExtra[]

  @@unique([bookingId, roomId])
  @@index([roomId, arrival, departure])
}

model BookingNote {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  AWAITING
  CANCELLED
  CHECKED_OUT        // legacy — plus jamais écrit par le code, conservé pour les lignes historiques
  CHECKED_OUT_UNPAID
  CHECKED_OUT_PAID
  CLOSED
}

// ─── Suppléments facturables (lit d'appoint, chauffage, etc.) ────

enum ExtraPricing {
  PER_NIGHT // multiplié par le nombre de nuits de la ligne BookingRoom
  ONE_TIME // facturé une seule fois, indépendant de la durée
}

model Extra {
  id        String             @id @default(cuid())
  name      String
  price     Int
  pricing   ExtraPricing       @default(ONE_TIME)
  // Suppression douce : un supplément déjà utilisé sur une réservation (même passée/clôturée) ne
  // doit jamais être réellement effacé, sinon l'historique des factures perdrait sa description.
  // Désactivé simplement retiré du choix pour de nouvelles lignes.
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  lines     BookingRoomExtra[]
}

model BookingRoomExtra {
  id            String       @id @default(cuid())
  bookingRoom   BookingRoom  @relation(fields: [bookingRoomId], references: [id], onDelete: Cascade)
  bookingRoomId String
  extra         Extra        @relation(fields: [extraId], references: [id])
  extraId       String
  quantity      Int          @default(1)
  // Snapshot du tarif/type au moment de l'ajout — même logique que BookingRoom.roomRate, qui
  // snapshot déjà roomType.rate : un changement de tarif catalogue ne doit pas modifier
  // rétroactivement une réservation déjà facturée.
  unitPrice     Int
  pricing       ExtraPricing

  @@unique([bookingRoomId, extraId])
}

// ─── Invoices ────────────────────────────────────────────────────

// STANDARD (facture normale) / DEPOSIT (acompte) / CREDIT_NOTE (avoir — une annulation à 100% du
// solde restant EST un avoir, pas un type séparé). Voir invoice.service.ts pour le cycle de vie
// brouillon → visé.
enum InvoiceKind {
  STANDARD
  DEPOSIT
  CREDIT_NOTE
}

model Invoice {
  id          String        @id @default(cuid())
  // Nullable : un brouillon (validatedAt = null) n'a pas encore de numéro — il n'en consomme un
  // qu'au visa, pour garantir une séquence sans trou dans l'ordre d'émission réel.
  number      String?       @unique
  kind        InvoiceKind   @default(STANDARD)
  booking     Booking       @relation(fields: [bookingId], references: [id])
  bookingId   String
  guest       Guest         @relation(fields: [guestId], references: [id])
  guestId     String
  issuedBy    User?         @relation(fields: [issuedById], references: [id])
  issuedById  String?
  status      InvoiceStatus @default(PENDING)
  // null = brouillon (librement modifiable, absent du grand livre) ; non-null = visé (figé, posté
  // au grand livre à cette date). `issuedAt` est (ré)écrit à la même valeur au moment du visa —
  // c'est la date d'émission légale, pas la date de création du brouillon.
  validatedAt DateTime?
  issuedAt    DateTime      @default(now())
  // Un CREDIT_NOTE pointe vers la facture qu'il crédite. Un DEPOSIT n'a pas besoin de FK vers la
  // facture finale qu'il alimente : il se retrouve par bookingId + kind (voir invoice.service.ts).
  relatesToInvoiceId String?
  relatesToInvoice   Invoice? @relation("InvoiceCredits", fields: [relatesToInvoiceId], references: [id])
  creditedBy         Invoice[] @relation("InvoiceCredits")
  dueAt       DateTime?
  paidAt      DateTime?
  totalAmount Int
  taxAmount   Int           @default(0)
  notes       String?
  items       InvoiceItem[]
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([bookingId, kind])
}

model InvoiceItem {
  id          String            @id @default(cuid())
  invoice     Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  quantity    Int               @default(1)
  unitPrice   Int
  total       Int
  // BOOKING : ligne dérivée de la réservation (chambre/supplément), réécrite à chaque
  // resynchronisation par syncInvoiceWithBooking. MANUAL : ligne libre ajoutée à la main sur la
  // facture (dégâts, service exceptionnel, remise avec unitPrice négatif…) — jamais touchée par la
  // resynchronisation, seuls les endpoints /invoices/:id/items la modifient.
  source      InvoiceItemSource @default(BOOKING)
  // Renseigné (1–100) uniquement pour une remise en pourcentage : `total` (négatif) est alors
  // recalculé à chaque resynchronisation à partir de la base du moment (somme des lignes à total
  // positif). null = ligne à montant figé — charge, ou remise en montant fixe (unitPrice négatif).
  discountRate Int?
}

enum InvoiceItemSource {
  BOOKING
  MANUAL
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  CANCELLED
}

// ─── Payments ────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  invoiceId     String
  processedBy   User          @relation(fields: [processedById], references: [id])
  processedById String
  amount        Int
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  // Compte de trésorerie réel qui a reçu l'argent (caisse, Mvola, Orange Money N°x...) — distinct
  // de `method` qui reste le canal de paiement affiché au client (une même méthode Orange Money
  // peut atterrir sur l'un ou l'autre des 2 numéros).
  account       LedgerAccount @relation(fields: [accountId], references: [id])
  accountId     String
  reference     String?
  paidAt        DateTime      @default(now())
  notes         String?
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  MVOLA
  ORANGE_MONEY
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

// ─── Comptabilité (partie double) ───────────────────────────────

model LedgerAccount {
  id            String            @id @default(cuid())
  code          String            @unique
  name          String
  type          LedgerAccountType
  // Comptes qui représentent un lieu physique d'argent (caisse, banque, mobile money) — ce sont
  // eux qui alimentent le tableau de bord "où est l'argent", par opposition aux comptes de
  // charges/produits/tiers qui n'ont pas de solde en espèces.
  isCashAccount Boolean           @default(false)
  // Méthodes de paiement que ce compte peut recevoir (ex: Caisse -> [CASH]) — filtre le
  // sélecteur de compte du formulaire de paiement selon la méthode choisie. Vide pour les
  // méthodes sans compte dédié pour l'instant (CARD/BANK_TRANSFER/ONLINE, pas de banque encore).
  allowedMethods PaymentMethod[]  @default([])
  parent        LedgerAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  parentId      String?
  children      LedgerAccount[]   @relation("AccountHierarchy")
  isActive      Boolean           @default(true)
  lines         JournalLine[]
  payments      Payment[]
  expenses      Expense[]
  expenseCategories ExpenseCategory[]
  roleAccess    RoleLedgerAccount[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// Accès d'un rôle à un compte de TRÉSORERIE (isCashAccount). Une ligne = ce rôle voit ce compte.
// Règle de visibilité : un rôle qui a au moins une ligne ne voit QUE ses comptes listés ; un rôle
// sans aucune ligne voit tout (défaut non-régressif) ; la permission `ledger.access_all_accounts`
// court-circuite tout.
//   canTransferFrom / canTransferTo : ce rôle peut utiliser ce compte comme source / arrivée d'un
//     virement ;
//   canPayExpenses : ce rôle peut payer une dépense depuis ce compte.
// Pour chacun de ces trois drapeaux : si le rôle n'a AUCUNE ligne où il est coché, tout compte
// visible convient (fallback permissif). Voir lib/treasuryAccess.ts.
model RoleLedgerAccount {
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId          String
  account         LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId       String
  canTransferFrom Boolean       @default(false)
  canTransferTo   Boolean       @default(false)
  canPayExpenses  Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@id([roleId, accountId])
  @@index([accountId])
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model JournalEntry {
  id               String        @id @default(cuid())
  number           String        @unique
  date             DateTime      @default(now())
  memo             String?
  source           JournalSource
  relatedPaymentId String?
  relatedInvoiceId String?
  relatedExpenseId String?
  postedBy         User?         @relation(fields: [postedById], references: [id])
  postedById       String?
  lines            JournalLine[]
  createdAt        DateTime      @default(now())

  @@index([date])
}

enum JournalSource {
  INVOICE
  INVOICE_CANCEL // legacy — plus jamais écrit (l'annulation d'une facture visée émet désormais un CREDIT_NOTE), conservé pour les écritures historiques
  CREDIT_NOTE
  PAYMENT
  PAYMENT_VOID
  EXPENSE
  TRANSFER
  CONTRIBUTION
  MANUAL
}

model JournalLine {
  id          String        @id @default(cuid())
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId     String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  accountId   String
  debit       Int           @default(0)
  credit      Int           @default(0)
  description String?

  @@index([accountId])
  @@index([entryId])
}

model Expense {
  id           String          @id @default(cuid())
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId   String
  amount       Int
  description  String
  paidFrom     LedgerAccount   @relation(fields: [paidFromId], references: [id])
  paidFromId   String
  approvedBy   User?           @relation(fields: [approvedById], references: [id])
  approvedById String?
  incurredAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([categoryId])
}

// Catégories de dépense configurables par l'ADMIN (écran dédié, voir accounts.manage_categories) —
// chacune débite un compte de charge (classe 6) précis à la création d'une dépense. Séparée du
// plan comptable : le nom ici est le vocabulaire métier vu par le personnel (ex. "Fournitures de
// ménage"), le compte lié reste le nom comptable technique (ex. "606100 — Achats de fournitures").
model ExpenseCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  accountId String
  isActive  Boolean       @default(true)
  expenses  Expense[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([accountId])
}

// ─── Audit ───────────────────────────────────────────────────────

// Capture générique de toute requête mutante (POST/PATCH/PUT/DELETE) authentifiée, posée par un
// middleware global plutôt qu'appelée à la main dans chaque service — sinon "toutes les actions"
// suppose de retoucher chaque route existante et d'y penser pour chaque future. En contrepartie,
// pas de texte métier lisible par écriture (ex: "Jean a confirmé la réservation X") : juste la
// requête brute (méthode, chemin, corps assaini, code retour), ce qui reste exploitable pour
// répondre à "qui a fait quoi, quand" sans devoir maintenir une liste de messages à jour.
model AuditLog {
  id           String   @id @default(cuid())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  method       String
  path         String
  resourceType String?
  resourceId   String?
  statusCode   Int
  body         Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ─── Permissions ─────────────────────────────────────────────────

// Catalogue des actions protégées de l'API — une entrée par permission logique (parfois
// plusieurs routes derrière une même clé quand elles ont toujours eu le même ensemble de rôles,
// ex: "bookings.manage_rooms" couvre 5 routes d'ajout/retrait de chambre et de supplément).
// `domain` regroupe pour un futur écran d'administration (Phase 3) — ex: "bookings", "invoices".
model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  domain      String
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

// Liaison Rôle x Permission — voir le modèle Role plus haut (rôles configurables).
model RolePermission {
  id           String     @id @default(cuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
}

// Objectif d'occupation saisi manuellement pour un mois donné (ex: 0.90 pour une prévision haute
// saison à 90 %) — comparé au taux d'occupation réel dans kpi.service.ts. Absence de ligne pour un
// mois ⇒ pas de comparaison affichée (pas de valeur par défaut arbitraire).
model KpiOccupancyTarget {
  id         String   @id @default(cuid())
  month      String   @unique
  targetRate Float    @map("target_rate")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("kpi_occupancy_target")
}

// ─── Vues KPI hôteliers (lecture seule) ──────────────────────────
// Toute l'agrégation SQL du tableau de bord KPI vit ici : explosion des nuitées, jointures,
// classification des comptes, normalisation de signe. Le DDL de ces vues est écrit à la main dans
// la migration `*_kpi_hotelier_views` (Prisma ne gère pas le DDL des vues). Une migration future
// qui altère une colonne dont dépend une vue doit d'abord la DROP puis la recréer.
// Le service (`kpi.service.ts`) ne fait que filtrer une période et calculer des ratios.

/// Une ligne par nuitée-chambre : chaque BookingRoom [arrival, departure) éclaté en nuits
/// calendaires (generate_series). `roomRate` = snapshot pris à la résa ; `catalogueRate` =
/// RoomType.rate courant (base du "CA théorique"). Pas de plancher `max(1, …)`.
view KpiRoomNight {
  nightDate     DateTime @map("night_date") @db.Date
  bookingId     String   @map("booking_id")
  roomId        String   @map("room_id")
  roomNumber    String   @map("room_number")
  roomTypeId    String   @map("room_type_id")
  roomTypeName  String   @map("room_type_name")
  roomRate      Int      @map("room_rate")
  catalogueRate Int      @map("catalogue_rate")
  bookingStatus String   @map("booking_status")

  @@unique([nightDate, bookingId, roomId])
  @@map("kpi_room_night")
}

/// Une ligne par chambre — pour le détail par chambre du tableau KPI (inclut les chambres sans
/// vente sur la période). `catalogueRate` = RoomType.rate.
view KpiRoom {
  roomId        String @unique @map("room_id")
  roomNumber    String @map("room_number")
  status        String
  roomTypeId    String @map("room_type_id")
  roomTypeName  String @map("room_type_name")
  catalogueRate Int    @map("catalogue_rate")

  @@map("kpi_room")
}

/// Grand livre agrégé au grain (jour d'écriture, compte, type, trésorerie ?, source).
/// `debit`/`credit` sont des SUM(int) → bigint. Signe calculé côté service (cf. normalBalance).
view KpiLedgerDaily {
  entryDate     DateTime @map("entry_date") @db.Date
  accountCode   String   @map("account_code")
  accountType   String   @map("account_type")
  isCashAccount Boolean  @map("is_cash_account")
  source        String
  debit         BigInt
  credit        BigInt

  @@unique([entryDate, accountCode, source])
  @@map("kpi_ledger_daily")
}

/// Une ligne par facture STANDARD visée (kind = STANDARD AND validatedAt IS NOT NULL).
view KpiInvoice {
  invoiceId     String   @unique @map("invoice_id")
  validatedDate DateTime @map("validated_date") @db.Date
  status        String
  totalAmount   Int      @map("total_amount")
  bookingId     String   @map("booking_id")

  @@map("kpi_invoice")
}

/// Inventaire chambres par type. `roomsAvailable` exclut le statut MAINTENANCE COURANT
/// (aucun historique de statut en base — approximation assumée).
view KpiRoomInventory {
  roomTypeId     String @unique @map("room_type_id")
  roomTypeName   String @map("room_type_name")
  catalogueRate  Int    @map("catalogue_rate")
  roomsAvailable BigInt @map("rooms_available")
  roomsTotal     BigInt @map("rooms_total")

  @@map("kpi_room_inventory")
}
