generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth / Staff ────────────────────────────────────────────────

model User {
  id                String        @id @default(cuid())
  username          String        @unique
  email             String?       @unique
  password          String
  name              String
  role              Role          @default(RECEPTIONIST)
  status            UserStatus    @default(ACTIVE)
  avatar            String?
  joinedDate        DateTime      @default(now())
  lastLogin         DateTime?
  guestNotes        GuestNote[]
  createdBookings   Booking[]
  issuedInvoices    Invoice[]
  processedPayments Payment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bookingNotes      BookingNote[]
}

enum Role {
  ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
}

enum UserStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

// ─── Guests ──────────────────────────────────────────────────────

model Guest {
  id            String      @id @default(cuid())
  name          String
  email         String?     @unique
  phone         String?
  address       String?
  city          String?
  country       String?
  status        GuestStatus @default(STANDARD)
  memberSince   DateTime    @default(now())
  totalStays    Int         @default(0)
  lifetimeValue Int         @default(0)
  avatar        String?
  preferences   String[]
  notes         GuestNote[]
  bookings      Booking[]
  invoices      Invoice[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum GuestStatus {
  STANDARD
  VIP_MEMBER
  VIP_ELITE
  PLATINUM_TIER
}

model GuestNote {
  id        String   @id @default(cuid())
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

// ─── Rooms ───────────────────────────────────────────────────────

model RoomType {
  id          String        @id @default(cuid())
  name        String
  rate        Int
  description String        @default("")
  area        Int           @default(30)
  bedType     String        @default("King Size")
  capacity    Int           @default(2)
  view        String        @default("Garden View")
  features    RoomFeature[] @relation("RoomTypeToFeature")
  rooms       Room[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Room {
  id           String        @id @default(cuid())
  number       String        @unique
  status       RoomStatus    @default(AVAILABLE)
  images       String[]      @default([])
  rateOverride Int?
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  roomTypeId   String
  bookings     BookingRoom[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

model RoomFeature {
  id        String     @id @default(cuid())
  label     String
  iconName  String
  roomTypes RoomType[] @relation("RoomTypeToFeature")
}

// ─── Bookings ────────────────────────────────────────────────────

model Booking {
  id           String        @id @default(cuid())
  guest        Guest         @relation(fields: [guestId], references: [id])
  guestId      String
  createdBy    User?         @relation(fields: [createdById], references: [id])
  createdById  String?
  rooms        BookingRoom[]
  invoices     Invoice[]
  arrival      DateTime
  departure    DateTime
  status       BookingStatus @default(AWAITING)
  totalAmount  Int
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookingNotes BookingNote[]
}

model BookingRoom {
  id        String             @id @default(cuid())
  booking   Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  room      Room               @relation(fields: [roomId], references: [id])
  roomId    String
  arrival   DateTime
  departure DateTime
  roomRate  Int
  extras    BookingRoomExtra[]

  @@unique([bookingId, roomId])
  @@index([roomId, arrival, departure])
}

model BookingNote {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  AWAITING
  CANCELLED
  CHECKED_OUT
}

// ─── Suppléments facturables (lit d'appoint, chauffage, etc.) ────

enum ExtraPricing {
  PER_NIGHT // multiplié par le nombre de nuits de la ligne BookingRoom
  ONE_TIME // facturé une seule fois, indépendant de la durée
}

model Extra {
  id        String             @id @default(cuid())
  name      String
  price     Int
  pricing   ExtraPricing       @default(ONE_TIME)
  // Suppression douce : un supplément déjà utilisé sur une réservation (même passée/clôturée) ne
  // doit jamais être réellement effacé, sinon l'historique des factures perdrait sa description.
  // Désactivé simplement retiré du choix pour de nouvelles lignes.
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  lines     BookingRoomExtra[]
}

model BookingRoomExtra {
  id            String       @id @default(cuid())
  bookingRoom   BookingRoom  @relation(fields: [bookingRoomId], references: [id], onDelete: Cascade)
  bookingRoomId String
  extra         Extra        @relation(fields: [extraId], references: [id])
  extraId       String
  quantity      Int          @default(1)
  // Snapshot du tarif/type au moment de l'ajout — même logique que BookingRoom.roomRate, qui
  // snapshot déjà roomType.rate : un changement de tarif catalogue ne doit pas modifier
  // rétroactivement une réservation déjà facturée.
  unitPrice     Int
  pricing       ExtraPricing

  @@unique([bookingRoomId, extraId])
}

// ─── Invoices ────────────────────────────────────────────────────

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  bookingId   String
  guest       Guest         @relation(fields: [guestId], references: [id])
  guestId     String
  issuedBy    User?         @relation(fields: [issuedById], references: [id])
  issuedById  String?
  status      InvoiceStatus @default(PENDING)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  totalAmount Int
  taxAmount   Int           @default(0)
  notes       String?
  items       InvoiceItem[]
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Int
  total       Int
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  CANCELLED
}

// ─── Payments ────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  invoiceId     String
  processedBy   User          @relation(fields: [processedById], references: [id])
  processedById String
  amount        Int
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  reference     String?
  paidAt        DateTime      @default(now())
  notes         String?
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  MVOLA
  ORANGE_MONEY
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}
