PUBLIC_API_URL=http://localhost:4000/api/public
# Origine publique du site : active l'aperçu de partage (og:image) et les hreflang. Vide en local.
# SITE_URL=https://www.example.com
# Build arg Docker uniquement (sans effet en `astro dev`) : production (défaut) | preprod.
# preprod → en-tête X-Robots-Tag noindex + robots.txt Disallow, le site n'est jamais indexé.
# PUBLIC_APP_ENV=preprod
# Umami (mesure d'audience sans cookies), production uniquement. Vide : aucun script chargé.
# Le script et l'envoi passent par /stats/, relayé par nginx vers UMAMI_UPSTREAM (variable
# d'exécution du conteneur, pas un build arg) : sans effet en `astro dev`.
# PUBLIC_UMAMI_WEBSITE_ID=
# UMAMI_UPSTREAM=https://stats.example.com
