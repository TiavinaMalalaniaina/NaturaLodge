---
import '../styles/global.css';
import '../styles/client.css';
import { localePath, alternatePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';
import Alternates from '../components/Alternates.astro';
import LegalLinks from '../components/LegalLinks.astro';

const { title, eyebrow, lang } = Astro.props as { title: string; eyebrow?: string; lang: Lang };
const t = ui[lang].layout;
const meta = ui[lang].meta;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#164d43" />
    <title>{title} · Natura Lodge</title>
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <Alternates />
    <link rel="icon" href="/favicon-rounded-32.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{meta.skip}</a>
    <header class="header client-header">
      <a href={localePath(lang, '/')} class="brand"><img src="/logo-symbol.png" alt="" width="88" height="44" /><span class="brand-name">Natura Lodge</span></a>
      <nav aria-label={t.nav}>
        <a href={localePath(lang, '/reservation/')}>{t.book}</a>
        <a href={localePath(lang, '/mes-reservations/')}>{t.myBookings}</a>
        <a href={localePath(lang, '/connexion/')} data-account>{t.login}</a>
        <button type="button" data-logout hidden>{t.logout}</button>
        <a href={alternatePath(Astro.url.pathname, other)} hreflang={other} lang={other} aria-label={meta.switchLabel} data-lang-switch>{meta.switchShort}</a>
      </nav>
    </header>
    <main id="contenu" class="wrap client-main">
      <p class="eyebrow green">{eyebrow ?? t.defaultEyebrow}</p><h1>{title}</h1>
      <p class="demo-banner">{t.banner}</p>
      <noscript><p class="demo-banner">{t.noscript}</p></noscript>
      <slot />
    </main>
    <footer class="wrap client-footer"><a href={localePath(lang, '/')}>{t.back}</a><LegalLinks lang={lang} /><span>Manambato, Madagascar · Natura Lodge</span></footer>
    <script src="../scripts/client.ts"></script>
  </body>
</html>
