---
import '../styles/global.css';
import { hotel, rooms, whatsappLink, formatPrice } from '../data/hotel';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  name: hotel.name,
  description: hotel.description,
  telephone: hotel.phoneLink,
  address: { '@type': 'PostalAddress', addressLocality: 'Manambato', addressCountry: 'MG' },
  sameAs: [hotel.facebook],
  hasMap: hotel.maps,
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#164d43" />
    <title>Natura Lodge Manambato — Vacances en famille près du lac</title>
    <meta name="description" content={hotel.description} />
    <meta property="og:title" content="Natura Lodge Manambato" />
    <meta property="og:description" content={hotel.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-rounded-32.png" />
    <link rel="icon" type="image/png" href="/icon-rounded.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-rounded.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="header">
      <a href="#accueil" class="brand" aria-label="Natura Lodge Manambato, accueil">
        <img src="/logo-symbol.png" alt="Natura Lodge Manambato" width="1774" height="887" />
        <span class="brand-name">Natura Lodge</span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation" aria-label="Ouvrir le menu">
        <span></span><span></span>
      </button>
      <nav id="navigation" aria-label="Navigation principale">
        <a href="#esprit">L’esprit Natura</a>
        <a href="#chambres">Nos chambres</a>
        <a href="#destination">Manambato</a>
        <a href="#contact" class="nav-contact">Préparer mon séjour <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="contenu">
      <section id="accueil" class="hero" aria-labelledby="hero-title">
        <img class="hero-image" src="/images/house.png" alt="La maison Natura Lodge Manambato et son jardin au coucher du soleil" width="565" height="565" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="hero-content wrap">
          <p class="eyebrow"><span class="location-dot" aria-hidden="true"></span> Manambato · Madagascar</p>
          <h1 id="hero-title">Les beaux jours<br />se vivent <em>ensemble.</em></h1>
          <p class="hero-description">Une maison moderne, le lac tout près.<br />Et du temps pour ceux qui comptent.</p>
          <a href="#chambres" class="button button-cream">Découvrir nos chambres <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-bottom wrap">
          <span>Votre parenthèse en famille</span>
          <a href="#esprit">Prendre le temps <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <div class="intro-strip">
        <span>Une escapade à Manambato</span><span aria-hidden="true">✳</span>
        <span>En famille, tout simplement</span><span aria-hidden="true">✳</span>
        <span>Des souvenirs à partager</span>
      </div>

      <section id="esprit" class="spirit section wrap" aria-labelledby="spirit-title">
        <div class="spirit-visual">
          <img src="/images/house-2.png" alt="Façade de Natura Lodge Manambato, ses terrasses et son jardin sous un ciel bleu" width="480" height="640" loading="lazy" />
          <div class="visual-seal" aria-hidden="true">Natura Lodge<span>Au rythme des vacances</span><b>✳</b></div>
        </div>
        <div class="spirit-copy">
          <p class="eyebrow green">Bienvenue chez nous</p>
          <h2 id="spirit-title">Un lieu pour souffler.<br /><em>Une maison pour se retrouver.</em></h2>
          <p>Il y a des moments où l’on a simplement envie de partir ensemble. De changer d’air, de ralentir et de profiter de sa famille.</p>
          <p>À Manambato, Natura Lodge vous accueille dans une maison moderne à l’ambiance conviviale, près du lac. Un point de départ pour vos vacances, à votre rythme.</p>
          <div class="spirit-details"><span>01 <strong>L’esprit famille</strong></span><span>02 <strong>Le lac à proximité</strong></span><span>03 <strong>Un cadre moderne</strong></span></div>
          <a href="#destination" class="text-link">Découvrir le cadre <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section id="chambres" class="rooms-section section" aria-labelledby="rooms-title">
        <div class="wrap">
          <div class="section-heading">
            <div><p class="eyebrow green">Poser ses valises</p><h2 id="rooms-title">À chacun sa place.<br /><em>À tous, de beaux moments.</em></h2></div>
            <p>À cinq ou à six, trouvez l’hébergement<br class="desktop-break" /> pour votre prochaine escapade en famille.</p>
          </div>
          <div class="room-grid">
            {rooms.map((room, index) => (
              <article class="room-card">
                <div class="room-photo">
                  <img src={room.image} alt={room.alt} width="480" height="360" loading="lazy" />
                  <span class="capacity">Jusqu’à {room.capacity} personnes</span>
                  <span class="photo-label">Aperçu des chambres de l’hôtel</span>
                </div>
                <div class="room-body">
                  <div class="room-name"><span class="room-number">0{index + 1}</span><h3>{room.name}</h3></div>
                  <p>{room.description}</p>
                  <div class="room-bottom"><div class="price">{formatPrice(room.price)} <span>{hotel.currency}</span><small>par nuit · par chambre</small></div>
                    <a class="room-link" href={whatsappLink(`Bonjour Natura Lodge ! Je souhaite connaître les disponibilités de la chambre ${room.name} (${room.capacity} personnes, ${formatPrice(room.price)} Ar par nuit). Mes dates : `)} target="_blank" rel="noopener noreferrer" aria-label={`Demander les disponibilités de la chambre ${room.name} sur WhatsApp`}><span aria-hidden="true">↗</span></a>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <div class="booking-note"><span class="note-mark" aria-hidden="true">i</span><p>{hotel.deposit} <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">Nous contacter <span aria-hidden="true">↗</span></a></p></div>
        </div>
      </section>

      <section id="destination" class="destination section wrap" aria-labelledby="destination-title">
        <div class="destination-copy">
          <p class="eyebrow green">L’envie d’ailleurs</p>
          <h2 id="destination-title">Manambato.<br /><em>Le temps de ralentir.</em></h2>
          <p>Le lac, l’air du dehors et le plaisir de se retrouver. Pour vos vacances en famille, prenez la direction de Manambato, à Madagascar.</p>
          <p>Vous préparez le trajet ? Retrouvez Natura Lodge Manambato sur Google Maps ou écrivez-nous : nous vous aiderons à organiser votre arrivée.</p>
          <a href={hotel.maps} class="text-link" target="_blank" rel="noopener noreferrer">Nous situer sur Google Maps <span aria-hidden="true">↗</span></a>
          <div class="destination-address"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><span>Natura Lodge Manambato<small>Manambato, Madagascar</small></span></div>
        </div>
        <div class="destination-photo"><img src="/images/plage.png" alt="La plage de sable, les arbres et le bord de l’eau à Manambato" width="565" height="565" loading="lazy" /><span class="photo-caption" aria-hidden="true">Une pause, ensemble.</span></div>
      </section>

      <section id="contact" class="contact-section" aria-labelledby="contact-title">
        <div class="contact-inner wrap">
          <div><p class="eyebrow">Et si on se retrouvait ici ?</p><h2 id="contact-title">Vos prochaines vacances<br /><em>commencent par un bonjour.</em></h2><p>Une question, des dates en tête ? Échangeons directement<br class="desktop-break" /> pour préparer votre séjour en famille.</p></div>
          <div class="contact-actions"><a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="button button-cream"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.6-4.7A9 9 0 1 1 21 11.5Z"/><path d="M8 7c-2 3 3 8 6 7l1-2-2-1-1 1-2-2 1-1-1-2Z"/></svg>Discuter sur WhatsApp <span aria-hidden="true">↗</span></a><a href={`tel:${hotel.phoneLink}`} class="phone-link">Ou appelez-nous au {hotel.phone}</a><span class="contact-note">Disponibilités et confirmation directement avec l’hôtel.</span></div>
        </div>
      </section>
    </main>

    <footer class="footer wrap">
      <div class="footer-top"><a href="#accueil" class="footer-brand"><img src="/logo-symbol.png" alt="Natura Lodge Manambato" width="1774" height="887" /></a><p>Le plaisir d’être ensemble.<br /><span>Manambato, Madagascar.</span></p><div><a href={hotel.facebook} target="_blank" rel="noopener noreferrer">Suivez-nous sur Facebook <span aria-hidden="true">↗</span></a><a href={`tel:${hotel.phoneLink}`}>{hotel.phone}</a></div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {hotel.name}</span><a href="#photos">À propos des photos</a><a href="#accueil">Retour en haut ↑</a></div>
      <p id="photos" class="photo-notice">Photographies de l’hôtel et de ses environs fournies par Natura Lodge Manambato. Les vues intérieures donnent un aperçu des chambres ; contactez-nous pour connaître la configuration disponible dans la catégorie souhaitée.</p>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#navigation');
      function closeMenu() {
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', 'Ouvrir le menu');
        navigation?.classList.remove('is-open');
      }
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
        navigation?.classList.toggle('is-open', open);
      });
      navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          toggle.focus();
        }
      });
      document.addEventListener('click', event => {
        if (event.target instanceof Node && !navigation?.contains(event.target) && !toggle?.contains(event.target)) closeMenu();
      });
      window.matchMedia('(min-width: 861px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
    </script>
  </body>
</html>
