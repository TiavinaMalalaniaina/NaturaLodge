---
import '../styles/global.css';
import { hotel, rooms, whatsappLink } from '../data/hotel';
import { formatPrice, localePath, alternatePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';
import Alternates from './Alternates.astro';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].home;
const meta = ui[lang].meta;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const whatsapp = whatsappLink(t.whatsappMessage);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  name: hotel.name,
  description: hotel.description[lang],
  telephone: hotel.phoneLink,
  address: { '@type': 'PostalAddress', addressLocality: 'Manambato', addressCountry: 'MG' },
  sameAs: [hotel.facebook],
  hasMap: hotel.maps,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#164d43" />
    <title>{meta.homeTitle}</title>
    <meta name="description" content={hotel.description[lang]} />
    <meta property="og:title" content="Natura Lodge Manambato" />
    <meta property="og:description" content={hotel.description[lang]} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    <Alternates />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-rounded-32.png" />
    <link rel="icon" type="image/png" href="/icon-rounded.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-rounded.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{meta.skip}</a>
    <header class="header">
      <a href="#accueil" class="brand" aria-label={t.brandLabel}>
        <img src="/logo-symbol.png" alt="Natura Lodge Manambato" width="1774" height="887" />
        <span class="brand-name">Natura Lodge</span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation" aria-label={t.openMenu} data-open-label={t.openMenu} data-close-label={t.closeMenu}>
        <span></span><span></span>
      </button>
      <nav id="navigation" aria-label={t.mainNav}>
        <a href="#esprit">{t.navSpirit}</a>
        <a href="#chambres">{t.navRooms}</a>
        <a href={localePath(lang, '/connexion/')}>{t.navAccount}</a>
        <a href={alternatePath(Astro.url.pathname, other)} hreflang={other} lang={other} aria-label={meta.switchLabel}>{meta.switchShort}</a>
        <a href={localePath(lang, '/reservation/')} class="nav-contact">{t.navBook} <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="contenu">
      <section id="accueil" class="hero" aria-labelledby="hero-title">
        <img class="hero-image" src="/images/house.png" alt={t.heroAlt} width="565" height="565" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="hero-content wrap">
          <p class="eyebrow"><span class="location-dot" aria-hidden="true"></span> Manambato · Madagascar</p>
          <h1 id="hero-title" set:html={t.heroTitle} />
          <p class="hero-description" set:html={t.heroText} />
          <a href="#chambres" class="button button-cream">{t.heroCta} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-bottom wrap">
          <span>{t.heroBottom}</span>
          <a href="#esprit">{t.heroScroll} <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <div class="intro-strip">
        <span>{t.strip[0]}</span><span aria-hidden="true">✳</span>
        <span>{t.strip[1]}</span><span aria-hidden="true">✳</span>
        <span>{t.strip[2]}</span>
      </div>

      <section id="esprit" class="spirit section wrap" aria-labelledby="spirit-title">
        <div class="spirit-visual">
          <img src="/images/house-2.png" alt={t.spiritAlt} width="480" height="640" loading="lazy" />
          <div class="visual-seal" aria-hidden="true">Natura Lodge<span>{t.seal}</span><b>✳</b></div>
        </div>
        <div class="spirit-copy">
          <p class="eyebrow green">{t.spiritEyebrow}</p>
          <h2 id="spirit-title" set:html={t.spiritTitle} />
          {t.spiritText.map(text => <p>{text}</p>)}
          <div class="spirit-details">{t.spiritDetails.map((detail, i) => <span>0{i + 1} <strong>{detail}</strong></span>)}</div>
          <a href="#destination" class="text-link">{t.spiritLink} <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section id="chambres" class="rooms-section section" aria-labelledby="rooms-title">
        <div class="wrap">
          <div class="section-heading">
            <div><p class="eyebrow green">{t.roomsEyebrow}</p><h2 id="rooms-title" set:html={t.roomsTitle} /></div>
            <p set:html={t.roomsText} />
          </div>
          <div class="room-grid">
            {rooms.map((room, index) => (
              <article class="room-card" data-room-type={room.roomType}>
                <div class="room-photo">
                  <img src={room.image} alt={room.alt[lang]} width="480" height="360" loading="lazy" />
                  <span class="capacity">{t.upTo} <span data-capacity>{room.capacity}</span> {t.persons}</span>
                  <span class="photo-label">{t.photoLabel}</span>
                </div>
                <div class="room-body">
                  <div class="room-name"><span class="room-number">0{index + 1}</span><h3>{room.name[lang]}</h3></div>
                  <p>{room.description[lang]}</p>
                  <div class="room-bottom"><div class="price"><span data-price>{formatPrice(room.price, lang)}</span> <span>{hotel.currency}</span><small>{t.perNight}</small></div>
                    <a class="room-link" href={`${localePath(lang, '/reservation/')}?type=${encodeURIComponent(room.roomType)}`} aria-label={`${t.bookRoom} ${room.name[lang]}`}><span aria-hidden="true">↗</span></a>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <div class="booking-note"><span class="note-mark" aria-hidden="true">i</span><p>{t.deposit} <a href={whatsapp} target="_blank" rel="noopener noreferrer">{t.contactUs} <span aria-hidden="true">↗</span></a></p></div>
        </div>
      </section>

      <section id="destination" class="destination section wrap" aria-labelledby="destination-title">
        <div class="destination-copy">
          <p class="eyebrow green">{t.destEyebrow}</p>
          <h2 id="destination-title" set:html={t.destTitle} />
          {t.destText.map(text => <p>{text}</p>)}
          <a href={hotel.maps} class="text-link" target="_blank" rel="noopener noreferrer">{t.destMap} <span aria-hidden="true">↗</span></a>
          <div class="destination-address"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><span>Natura Lodge Manambato<small>Manambato, Madagascar</small></span></div>
        </div>
        <div class="destination-photo"><img src="/images/plage.png" alt={t.beachAlt} width="565" height="565" loading="lazy" /><span class="photo-caption" aria-hidden="true">{t.beachCaption}</span></div>
      </section>

      <section id="contact" class="contact-section" aria-labelledby="contact-title">
        <div class="contact-inner wrap">
          <div><p class="eyebrow">{t.contactEyebrow}</p><h2 id="contact-title" set:html={t.contactTitle} /><p set:html={t.contactText} /></div>
          <div class="contact-actions"><a href={whatsapp} target="_blank" rel="noopener noreferrer" class="button button-cream"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.6-4.7A9 9 0 1 1 21 11.5Z"/><path d="M8 7c-2 3 3 8 6 7l1-2-2-1-1 1-2-2 1-1-1-2Z"/></svg>{t.whatsapp} <span aria-hidden="true">↗</span></a><a href={`tel:${hotel.phoneLink}`} class="phone-link">{t.callUs} {hotel.phone}</a><span class="contact-note">{t.contactNote}</span></div>
        </div>
      </section>
    </main>

    <footer class="footer wrap">
      <div class="footer-top"><a href="#accueil" class="footer-brand"><img src="/logo-symbol.png" alt="Natura Lodge Manambato" width="1774" height="887" /></a><p>{t.footerTagline}<br /><span>Manambato, Madagascar.</span></p><div><a href={hotel.facebook} target="_blank" rel="noopener noreferrer">{t.facebook} <span aria-hidden="true">↗</span></a><a href={`tel:${hotel.phoneLink}`}>{hotel.phone}</a></div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {hotel.name}</span><a href="#photos">{t.aboutPhotos}</a><a href="#accueil">{t.backTop}</a></div>
      <p id="photos" class="photo-notice">{t.photoNotice}</p>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#navigation');
      const openLabel = toggle?.dataset.openLabel ?? '';
      const closeLabel = toggle?.dataset.closeLabel ?? '';
      function closeMenu() {
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', openLabel);
        navigation?.classList.remove('is-open');
      }
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
        navigation?.classList.toggle('is-open', open);
      });
      navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          toggle.focus();
        }
      });
      document.addEventListener('click', event => {
        if (event.target instanceof Node && !navigation?.contains(event.target) && !toggle?.contains(event.target)) closeMenu();
      });
      window.matchMedia('(min-width: 861px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
    </script>
    <script>
      import { formatPrice, pageLang } from '../i18n';
      type RoomType = { name: string; price: number; capacity: number };
      const api = (import.meta.env.PUBLIC_API_URL || 'http://localhost:4000/api/public').replace(/\/$/, '');
      const normalize = (value: string) => value.trim().toLowerCase();
      fetch(`${api}/room-types`, { cache: 'no-store' })
        .then(res => res.ok ? res.json() as Promise<RoomType[]> : Promise.reject(res.status))
        .then(types => {
          document.querySelectorAll<HTMLElement>('[data-room-type]').forEach(card => {
            const type = types.find(t => normalize(t.name) === normalize(card.dataset.roomType ?? ''));
            if (!type) return;
            card.querySelector('[data-price]')!.textContent = formatPrice(type.price, pageLang());
            card.querySelector('[data-capacity]')!.textContent = String(type.capacity);
          });
        })
        .catch(() => { /* API unreachable: static prices from hotel.ts stay displayed */ });
    </script>
  </body>
</html>
