---
import { alternatePath, languages } from '../i18n';

// hreflang requires absolute URLs: only emitted once `site` is set in astro.config.mjs (real domain).
const site = Astro.site;
---
{site && languages.map(lang => <link rel="alternate" hreflang={lang} href={new URL(alternatePath(Astro.url.pathname, lang), site).toString()} />)}
{site && <link rel="alternate" hreflang="x-default" href={new URL(alternatePath(Astro.url.pathname, 'fr'), site).toString()} />}
