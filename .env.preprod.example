# Variables de docker-compose.preprod.yml, à saisir dans Coolify (ressource preprod → Environment
# Variables). Ne jamais committer ce fichier rempli.
# Toutes les valeurs doivent DIFFÉRER de la production.

# ─── Base de données (propre à la préprod) ─────────────────────────────────────
PREPROD_DB_USER=naturalodge_preprod
PREPROD_DB_NAME=naturalodge_preprod
# Caractères hexadécimaux uniquement : le mot de passe est inséré tel quel dans DATABASE_URL.
# openssl rand -hex 24
PREPROD_DB_PASSWORD=

# ─── Serveur ───────────────────────────────────────────────────────────────────
# openssl rand -hex 32 — jamais le secret de prod : un jeton de préprod ne doit pas valoir en prod.
PREPROD_JWT_SECRET=
PREPROD_JWT_EXPIRES_IN=1d
PREPROD_LOG_LEVEL=debug

# Adresses publiques (https obligatoire, le serveur refuse de démarrer sinon) : exactement les
# domaines attribués dans Coolify aux services `client` (admin) et `website` (site).
PREPROD_FRONTEND_URL=https://admin-preprod.votre-domaine.com
PREPROD_WEBSITE_URL=https://preprod.votre-domaine.com
PREPROD_TRUST_PROXY=loopback, uniquelocal

# ─── Connexion Google (facultatif : bouton masqué si vide) ─────────────────────
# Client OAuth propre à la préprod (ou URI ajoutée au client existant) ; URI de redirection autorisée :
# PREPROD_WEBSITE_URL + /api/public/auth/google/callback
PREPROD_GOOGLE_CLIENT_ID=
PREPROD_GOOGLE_CLIENT_SECRET=

# ─── Emails ────────────────────────────────────────────────────────────────────
# Envoyés réellement. Facultatif : si PREPROD_MAIL_REDIRECT_TO est défini, TOUS les emails y sont
# redirigés, avec le vrai destinataire dans le sujet : « [PREPROD → client@exemple.com] ... ».
# Laisser vide pour que les emails partent aux vrais destinataires (démonstration client).
PREPROD_MAIL_REDIRECT_TO=
PREPROD_MAIL_FROM="Natura Lodge PREPROD <preprod@votre-domaine.com>"
# Si l'hébergeur bloque les ports SMTP sortants (cas des offres gratuites de certains PaaS), utiliser un
# service transactionnel sur le port 2525 (Brevo, SendGrid, Mailgun…).
PREPROD_SMTP_HOST=smtp.example.com
PREPROD_SMTP_PORT=587
PREPROD_SMTP_SECURE=false
PREPROD_SMTP_USER=
PREPROD_SMTP_PASSWORD=

# ─── Notifications push (facultatif) ───────────────────────────────────────────
# Paire propre à la préprod : npx web-push generate-vapid-keys
PREPROD_VAPID_PUBLIC_KEY=
PREPROD_VAPID_PRIVATE_KEY=
PREPROD_VAPID_SUBJECT=mailto:contact@votre-domaine.com
